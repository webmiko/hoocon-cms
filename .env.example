# Copy to .env for local development. Do not commit real secrets.

DJANGO_SECRET_KEY=change-me-in-local-env
# Explicit True for local; default in settings is False (fail-closed).
DJANGO_DEBUG=True
# Preview articles/news with future published_at (prod: leave unset/False).
CONTENT_SHOW_SCHEDULED=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Public site URL (canonical / OG) and SPA shell for server-side SEO head.
SITE_URL=https://hoocon.ru
# SPA_INDEX_HTML=/absolute/path/to/frontend/dist/index.html

# Analytics counters (Admin SiteSettings preferred; env / VITE_* as fallback).
# Public IDs — not secrets. Empty Admin uses these Django/Vite defaults.
YANDEX_METRIKA_ID=73321399
GA4_MEASUREMENT_ID=G-DLRV7BZ5JP

# Social bots: preferred in Admin → Настройки сайта → Интеграции.
# .env remains a fallback when Admin token fields are empty.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_BOT_USERNAME=HooconMsk_bot  # t.me/<bot>?start= — переписка с ботом
# TELEGRAM_CHANNEL_USERNAME=hoocon_moscow  # t.me/<name> — канал в футере
# TELEGRAM_WELCOME_PHOTO_PATH=
# TELEGRAM_WELCOME_PHOTO_URL=https://hoocon-telegram-api.npok9.workers.dev/welcome.jpg
# Cloudflare Worker reverse proxy when VPS cannot reach api.telegram.org:
# TELEGRAM_API_BASE=https://hoocon-telegram-api.npok9.workers.dev
# TELEGRAM_PROXY_URL=  # optional HTTP(S) proxy instead of / in addition to API_BASE
# VK_ACCESS_TOKEN=

# MAX messenger — бот @id5024199634_bot, канал @id5024199634_biz
# Токен: platform.max.ru → Чат-боты → бот → ⋮ → Настройки → скопировать токен
# MAX_BOT_TOKEN=
# Webhook (POST /subscriptions secret → заголовок X-Max-Bot-Api-Secret на hoocon.ru):
# MAX_WEBHOOK_SECRET=
# Публичные ники для deep link и виджета поддержки (без @):
# MAX_BOT_USERNAME=id5024199634_bot
# MAX_CHANNEL_USERNAME=id5024199634_biz
# ID чата канала для анонсов новостей — проще в Admin → Интеграции → MAX chat ID;
# числовой chat_id канала (не @ник). Бот должен быть админом канала.
# MAX_CHAT_ID=

# GigaChat API — ассистент support-чата (Studio → GigaChat API → Настройки API).
# Authorization Key без префикса Basic. Можно также задать в Admin → Интеграции.
# GIGACHAT_CREDENTIALS=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat-2
# TLS проверяется с бандлом Минцифры (backend/certs); false — только для отладки
# GIGACHAT_VERIFY_SSL=true
# triage — холодный чат (приветствие → менеджер при вопросах о продукции); full — БЗ
# GIGACHAT_MODE=triage
# Через сколько секунд после эскалации бот просит email, если менеджер не открыл чат
# SUPPORT_ESCALATION_BUSY_FOLLOWUP_SECONDS=300
# Менеджер вёл диалог и замолчал — через столько секунд отвечает бот
# SUPPORT_MANAGER_REPLY_TIMEOUT_SECONDS=45
# Передачу менеджеру никто не взял — через столько минут чат возвращается боту
# SUPPORT_AI_RESUME_STALE_MINUTES=30
# Редакция политики ПДн для согласий (лид, кабинет, чат); менять с новой /privacy.
# PDN_POLICY_VERSION=2026-10-09
# Superuser recovery codes: misses per login before a lock (seconds).
# ADMIN_RECOVERY_MAX_FAILS=5
# ADMIN_RECOVERY_LOCK_SECONDS=900

# Prod / VPS (set when DJANGO_DEBUG=False) — see docs/security-baseline.md
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_BEHIND_HTTPS_PROXY=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_PRELOAD=True
# After domain+HTTPS only (ignored on http://IP → console noise):
# DJANGO_SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin
# Reverse proxies that set X-Forwarded-For (host nginx = 1; add CDN hops).
# TRUSTED_PROXY_HOPS=1

# gunicorn workers (Dockerfile falls back to 2). The catalog page fires
# categories + facets + skus at once, so 2 workers leave the third request
# queueing behind the other two. Size it to vCPU — the load is CPU-bound
# serialization, not I/O, so more workers than cores only adds switching.
# WEB_CONCURRENCY=4

DB_NAME=hoocon
DB_USER=hoocon
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# PostgreSQL only — local: docker compose up -d db

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Лимиты задачи Celery (сек): мягкий → SoftTimeLimitExceeded, жёсткий → kill
# CELERY_TASK_SOFT_TIME_LIMIT=300
# CELERY_TASK_TIME_LIMIT=360
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# Shared cache for DRF throttles (prod uses Redis DB 2 by default when DEBUG=False)
# DJANGO_CACHE_URL=redis://127.0.0.1:6379/2
# CI / no Redis: DJANGO_CACHE_URL=locmem://
# Short GET cache for /api/catalog/{categories,facets,skus} (bot-load phase 0).
# CATALOG_HTTP_CACHE_SECONDS=30
# CATALOG_HTTP_CACHE_SECONDS=0  # disable
# CELERY_TASK_ALWAYS_EAGER=True

# CORS / CSRF trusted origins (SPA + prod domain)
# Local SPA: Vite on 5174 (pinned for hoocon-cms; backend 8002).
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Prod example (DJANGO_DEBUG=False without these → no extra origin is trusted):
# CORS_ALLOWED_ORIGINS=https://hoocon.ru,https://www.hoocon.ru
# CSRF_TRUSTED_ORIGINS=https://hoocon.ru,https://www.hoocon.ru
# Media hotlink (foreign <img src="/media/..."> → 403). Empty Referer allowed.
# MEDIA_HOTLINK_ENABLED=true
# MEDIA_HOTLINK_ALLOW_EMPTY_REFERER=true
# MEDIA_HOTLINK_EXTRA_HOSTS=staging.hoocon.ru

# SMTP (Яндекс 360 on prod) — leave empty locally if unused
# Used for: lead notifications + CRM outbound mail from Admin
# sales@ = общий ящик отдела (только LEAD_NOTIFY); SMTP — обычный noreply@
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=465
# EMAIL_HOST_USER=noreply@hoocon.ru
# EMAIL_HOST_PASSWORD=   # пароль приложения Яндекс ID ящика noreply@
# EMAIL_USE_SSL=True
# DEFAULT_FROM_EMAIL=noreply@hoocon.ru
# Local OTP smoke without SMTP: EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Comma-separated managers for new-lead email (HTML+text). Celery worker required.
# LEAD_NOTIFY_EMAIL=sales@hoocon.ru
# Manager reply signatures (JSON; default — assistant@hoocon.ru / Людмила):
# MANAGER_SIGNATURE_CONTACTS_JSON={"assistant@hoocon.ru": {"name": "Людмила", "company": "ООО \"ХОГОН\"", "phone": "+7(995)780-70-18"}}
# For CRM «Написать письмо» / lead email: Celery worker + SMTP above required.

# IMAP inbound mail (CRM-mail сборщик: beat-задача crm.fetch_inbound_email,
# каждые 2 мин). Яндекс 360 webhook не отдаёт — только IMAP с паролем
# приложения. Два источника:
#  - личные ящики менеджеров — вводятся на странице пользователя
#    (Пользователи → <user> → «Почта менеджера (IMAP)»), там же свой
#    пароль приложения и курсор last_uid;
#  - общий ящик — блок ниже (IMAP_ENABLED=true), опционально.
# Без обоих источников задача сразу выходит (disabled).
# IMAP_ENABLED=true
# IMAP_HOST=imap.yandex.ru   # хост/порт общие для всех ящиков (Яндекс 360)
# IMAP_PORT=993
# IMAP_USER=sales@hoocon.ru
# IMAP_PASSWORD=   # пароль приложения Яндекс ID ящика sales@
# IMAP_FOLDER=INBOX
# IMAP_USE_SSL=true
# IMAP_FETCH_LIMIT=50        # лимит писем за прогон на каждый ящик
# IMAP_TIMEOUT=30            # секунд на сетевую операцию IMAP
# EMAIL_TIMEOUT=30           # секунд на SMTP (общий и личные ящики)

# Mango VPBX (IP-телефония). Ключи — ЛК Mango Office → Интеграции → API.
# Входящие события: в ЛК указать URL
#   https://<домен>/api/telephony/mango/events/
# Звонки пишутся в раздел «Звонки» (CRM), по завершении — Activity на
# карточке клиента; записи разговоров скачиваются в приватное медиа.
# Добавочный менеджера — на странице пользователя (Пользователи → <user>
# → «Добавочный сотрудника (Mango)»).
# MANGO_VPBX_API_KEY=
# MANGO_VPBX_API_SALT=
# Click-to-call без полного API (ЛК → Интеграции → Вебхуки → «исходящие
# звонки через вебхук»): вставь сгенерированный URL и замени значения
# EmployeeNUM на {ext}, TelNumbr на {num}. Достаточно без API-ключей.
# MANGO_CALLBACK_WEBHOOK_URL=https://integration-webhook.mango-office.ru/webhookapp/common?code=XXX&Source=Other&API_key=YYY&Action=Callback&EmployeeNUM={ext}&TelNumbr={num}

# Admin Email OTP (passwordless /admin/login — 6-digit code to staff email)
# Superuser break-glass (no extra env): ?mode=password and recovery codes in Admin.
# ADMIN_EMAIL_OTP_ENABLED=true
# ADMIN_EMAIL_OTP_TTL_SECONDS=300
# ADMIN_EMAIL_OTP_MAX_ATTEMPTS=5
# ADMIN_EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
# Exact emails and/or domains: admin@example.com,@hoocon.ru (or *@hoocon.ru)
# ADMIN_EMAIL_OTP_ALLOWED_EMAILS=admin@example.com,@hoocon.ru
# ADMIN_EMAIL_OTP_REQUEST_LIMIT=5
# ADMIN_EMAIL_OTP_REQUEST_WINDOW_SECONDS=600

# Client cabinet auth (ЛК-0): session cookie, пароль или email OTP.
# OTP-коды хранятся в shared cache (Redis на проде) — не в БД.
# CLIENT_OTP_TTL_SECONDS=300
# CLIENT_OTP_MAX_ATTEMPTS=5
# CLIENT_OTP_RESEND_COOLDOWN_SECONDS=60
# CLIENT_OTP_REQUEST_LIMIT=20          # запросов кода на IP за окно
# CLIENT_OTP_REQUEST_WINDOW_SECONDS=3600
# Цены/суммы в кабинете — только в PDF счёта; флаг открывает totals в API.
# CABINET_SHOW_PRICES=false
# Yandex ID OAuth (ЛК-0 mode C) — отдельная итерация, флаг-заготовка.
# YANDEX_OAUTH_ENABLED=false
# YANDEX_OAUTH_CLIENT_ID=
# YANDEX_OAUTH_CLIENT_SECRET=
# YANDEX_OAUTH_REDIRECT_URI=https://hoocon.ru/auth/yandex/callback

# Admin WebAuthn passkeys (Связка ключей / Google Password Manager)
# ADMIN_PASSKEY_ENABLED=true
# ADMIN_PASSKEY_RP_ID=hoocon.ru
# ADMIN_PASSKEY_RP_NAME=HOOCON CMS
# ADMIN_PASSKEY_ORIGIN=https://hoocon.ru
# Local example: RP_ID=localhost, ORIGIN=http://127.0.0.1:8002
# ADMIN_PASSKEY_CHALLENGE_TTL_SECONDS=300

# Staff mobile API (Flutter manager — internal APK)
# STAFF_API_ENABLED=true
# FCM HTTP v1: Firebase → Project settings → Service accounts → Generate key.
# Mount the JSON read-only and point to it (or paste it into *_JSON).
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
# FCM_SERVICE_ACCOUNT_JSON=

# Web Push (PWA) — poetry run vapid --gen  (never commit private key)
# WEBPUSH_VAPID_PUBLIC_KEY=
# WEBPUSH_VAPID_PRIVATE_KEY=
# WEBPUSH_VAPID_SUBJECT=mailto:noreply@hoocon.ru

# Ops alerts (HTTP 5xx + monitor-health) — Telegram chat IDs, comma-separated.
# Chat id: DM the bot → /chatid. Requires TELEGRAM_BOT_TOKEN.
# OPS_TELEGRAM_CHAT_IDS=
# OPS_ALERT_DEDUP_SECONDS=900

# Pre-cutover HTTPS (Telegram webhook via sslip.io). Set on VPS .env only — not in git.
# VPS_SSLIP_DOMAIN=203.0.113.10.sslip.io
