    ProductFileUpload:
      type: object
      description: Serializer for staff upload (POST) and public read (GET).
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          title: Название
          maxLength: 300
        file:
          type: string
          format: uri
          title: Файл
          description: Только PDF; размер и тип файла проверяются при загрузке.
        file_type:
          allOf:
          - $ref: '#/components/schemas/FileTypeEnum'
          title: Тип файла
        is_published:
          type: boolean
          title: Опубликован
          description: Видимость файла в публичном каталоге и на карточке товара.
        sort_order:
          type: integer
          maximum: 2147483647
          minimum: 0
          title: Порядок
          description: Порядок в блоке «Документы» (меньше = выше).
      required:
      - file
      - id
      - title
    SKUDetail:
      type: object
      description: 'SKU PDP payload: list fields + sectioned copy + attributes + files.'
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          description: 'H1/card title: series Product name on family list cards, else
            edition.'
          readOnly: true
        slug:
          type: string
          readOnly: true
          title: Сегмент URL
          pattern: ^[-a-zA-Z0-9_]+$
        sku_code:
          type: string
          readOnly: true
          title: Артикул
          description: Артикул (уникален, не пуст), напр. HVA-5NM или BV215.
        analog_belimo_code:
          type: string
          readOnly: true
          nullable: true
          title: Код аналога Belimo
          description: Код аналога Belimo (для будущей карты аналогов).
        category_slug:
          type: string
          readOnly: true
        product_slug:
          type: string
          readOnly: true
        price:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          readOnly: true
          nullable: true
          title: Цена
          description: Цена для КП менеджеру. В публичный API не попадает (см. настройку
            «показывать цены на сайте»).
        price_on_request:
          type: boolean
          description: True when prices are hidden (RFQ policy).
          readOnly: true
        in_stock:
          type: boolean
          description: True when warehouse quantity is positive (no raw qty in public
            API).
          readOnly: true
        is_new:
          type: boolean
          description: True when first_published_at is within the Новинки window (30
            days).
          readOnly: true
        first_published_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
          title: Впервые на сайте
          description: Когда SKU впервые стал виден в публичном каталоге. Окно «Новое»
            — 30 суток; не путать с датами создания/обновления ETL.
        edition_count:
          type: integer
          description: Published SKU count on the same Product (family card signal).
          readOnly: true
        image:
          type: object
          additionalProperties: {}
          nullable: true
          description: Primary published image for catalog cards (sort_order ASC).
          readOnly: true
        highlights:
          type: array
          items:
            type: object
            additionalProperties:
              type: string
          description: 'Hero ТТХ on PDP: fuller set than catalog cards.'
          readOnly: true
        description:
          type: string
          description: |-
            Return description for this SKU edition only (no H1/lead/EAV echo).

            Drops bullets that only restate AttributeValue rows already shown in
            ТТХ cards / highlights (e.g. «Управление: …», «Вспомогательный…»).
            When nothing remains but a hero lead exists, return a light paraphrase
            of that lead for the Описание tab (SEO-safe, not an exact duplicate).
          readOnly: true
        lead:
          type: string
          description: Short prose blurb for PDP hero (application sentence).
          readOnly: true
        specs_text:
          type: string
          description: |-
            Характеристики prose — only when there are no structured attrs.

            When EAV / category cards cover the ТТХ, return empty to avoid a
            duplicate StructuredText block under the cards.
          readOnly: true
        analogs_text:
          type: string
          description: Return Аналоги for this SKU edition.
          readOnly: true
        category_name:
          type: string
          readOnly: true
        category_description:
          type: string
          readOnly: true
        category_instructions:
          type: string
          description: Install guide scoped to this SKU edition (all series).
          readOnly: true
        ball_valve_kit:
          type: object
          additionalProperties: {}
          nullable: true
          description: Optional actuator + bracket picker for ball-valve RFQ.
          readOnly: true
        compatible_positions:
          type: array
          items:
            type: object
            additionalProperties: {}
          description: Adapter ↔ brass 8100 cross-links for PDP («Совместимые позиции»).
          readOnly: true
        siblings:
          type: array
          items:
            type: object
            additionalProperties: {}
          description: Same-product editions for the PDP variant picker (empty if
            alone).
          readOnly: true
        variant_axes:
          type: object
          additionalProperties:
            type: array
            items:
              type: string
          description: Unique DN / Kvs / voltage / control values among siblings.
          readOnly: true
        attributes:
          type: array
          items:
            type: object
            additionalProperties: {}
          description: ТТХ rows deduped and scoped to the SKU voltage/control variant.
          readOnly: true
        attribute_groups:
          type: array
          items:
            type: object
            additionalProperties: {}
          description: ТТХ grouped for category cards on the Характеристики tab.
          readOnly: true
        files:
          type: array
          items:
            type: object
            additionalProperties: {}
          description: Return only published ProductFile rows, ordered.
          readOnly: true
        images:
          type: array
          items:
            type: object
            additionalProperties: {}
          description: Return published gallery images for this edition only.
          readOnly: true
      required:
      - analog_belimo_code
      - analogs_text
      - attribute_groups
      - attributes
      - ball_valve_kit
      - category_description
      - category_instructions
      - category_name
      - category_slug
      - compatible_positions
      - description
      - edition_count
      - files
      - first_published_at
      - highlights
      - id
      - image
      - images
      - in_stock
      - is_new
      - lead
      - name
      - price
      - price_on_request
      - product_slug
      - siblings
      - sku_code
      - slug
      - specs_text
      - variant_axes
