    SearchResponse:
      type: object
      description: Paginated search response (DRF PageNumberPagination shape).
      properties:
        count:
          type: integer
        next:
          type: string
          format: uri
          nullable: true
        previous:
          type: string
          format: uri
          nullable: true
        results:
          type: array
          items:
            $ref: '#/components/schemas/SearchResultItem'
      required:
      - count
      - next
      - previous
      - results
    SearchResultItem:
      type: object
      description: One item in the unified search results list.
      properties:
        type:
          type: string
          description: 'Тип результата: sku | article | news | page.'
        slug:
          type: string
          description: Slug (path-сегмент) найденной записи.
        title:
          type: string
          description: Заголовок (H1) найденной записи.
        url:
          type: string
          description: Канонический path (напр. /<slug>/, /statyi/<slug>/).
        snippet:
          type: string
          description: Краткое описание (для SKU — lead с PDP; для CMS — начало body).
      required:
      - slug
      - snippet
      - title
      - type
      - url
    StatusEnum:
      enum:
      - new
      - in_progress
      - done
      type: string
      description: |-
        * `new` - Новая
        * `in_progress` - В работе
        * `done` - Завершена
  securitySchemes:
    basicAuth:
      type: http
      scheme: basic
    cookieAuth:
      type: apiKey
      in: cookie
      name: sessionid
