openapi: 3.0.3
info:
  title: Hoocon CMS API
  version: 0.1.17
  description: B2B catalog and content API for Hoocon HVAC actuators.
paths:
  /api/catalog/categories/:
    get:
      operationId: catalog_categories_list
      description: List categories with a product preview image per row.
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      tags:
      - catalog
      security:
      - cookieAuth: []
      - basicAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedCategoryList'
          description: ''
  /api/catalog/compare/:
    get:
      operationId: catalog_compare_retrieve
      description: Return SKU columns and highlight matrix rows.
      tags:
      - catalog
      security:
      - cookieAuth: []
      - basicAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/catalog/facets/:
    get:
      operationId: catalog_facets_retrieve
      description: Return canonical facets for the catalog filter UI.
      tags:
      - catalog
      security:
      - cookieAuth: []
      - basicAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/catalog/skus/:
    get:
      operationId: catalog_skus_list
      description: GET /api/catalog/skus/ and /api/catalog/skus/{slug}/.
      parameters:
      - name: analog
        required: false
        in: query
        description: 'ТТХ facet: Аналоги'
        schema:
          type: string
      - name: area
        required: false
        in: query
        description: 'ТТХ facet: Площадь заслонки'
        schema:
          type: string
      - name: aux_switch
        required: false
        in: query
        description: 'ТТХ facet: Вспомогательный переключатель'
        schema:
          type: string
      - in: query
        name: category
        schema:
          type: string
      - name: compatible_actuators
        required: false
        in: query
        description: 'ТТХ facet: Совместимый привод'
        schema:
          type: string
      - name: control
        required: false
        in: query
        description: 'ТТХ facet: Управление'
        schema:
          type: string
      - name: dn
        required: false
        in: query
        description: 'ТТХ facet: DN'
        schema:
          type: string
      - name: in_stock
        required: false
        in: query
        description: 'Только товары в наличии (stock_qty > 0). Значения: 1 / true
          / yes.'
        schema:
          type: string
          enum:
          - '1'
          - 'true'
          - 'yes'
      - name: kvs
        required: false
        in: query
        description: 'ТТХ facet: Kvs (м³/ч)'
        schema:
          type: string
      - name: material
        required: false
        in: query
        description: 'ТТХ facet: Материал корпуса'
        schema:
          type: string
      - name: moment
        required: false
        in: query
        description: 'ТТХ facet: Крутящий момент'
        schema:
          type: string
      - name: new
        required: false
        in: query
        description: 'Только новинки (first_published_at за последние 30 суток). Порядок:
          в наличии, затем newer first. Значения: 1 / true / yes.'
        schema:
          type: string
          enum:
          - '1'
          - 'true'
          - 'yes'
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - in: query
        name: q
        schema:
          type: string
      - name: temp_sensor
        required: false
        in: query
        description: 'ТТХ facet: Термодатчик'
        schema:
          type: string
      - name: voltage
        required: false
        in: query
        description: 'ТТХ facet: Напряжение'
        schema:
          type: string
      - name: ways
        required: false
        in: query
        description: 'ТТХ facet: Тип крана'
        schema:
          type: string
      tags:
      - catalog
      security:
      - cookieAuth: []
      - basicAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedSKUListList'
          description: ''
  /api/catalog/skus/{sku_slug}/files/:
    get:
      operationId: catalog_skus_files_list
      description: GET (public) + POST (staff) /api/catalog/skus/{sku_slug}/files/.
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - in: path
        name: sku_slug
        schema:
          type: string
        required: true
      tags:
      - catalog
      security:
      - cookieAuth: []
      - basicAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedProductFileUploadList'
          description: ''
    post:
      operationId: catalog_skus_files_create
      description: Upload a PDF to the SKU identified by sku_slug in the URL.
      parameters:
      - in: path
        name: sku_slug
        schema:
          type: string
        required: true
      tags:
      - catalog
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ProductFileUpload'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ProductFileUpload'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ProductFileUpload'
        required: true
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ProductFileUpload'
          description: ''
  /api/catalog/skus/{slug}/:
    get:
      operationId: catalog_skus_retrieve
      description: GET /api/catalog/skus/ and /api/catalog/skus/{slug}/.
      parameters:
      - in: path
        name: slug
        schema:
          type: string
          title: Сегмент URL
        required: true
      tags:
      - catalog
      security:
      - cookieAuth: []
      - basicAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SKUDetail'
          description: ''
  /api/content/articles/:
    get:
      operationId: content_articles_list
      description: GET /api/content/articles/ and /api/content/articles/{slug}/.
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      tags:
      - content
      security:
      - cookieAuth: []
      - basicAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedArticleListList'
          description: ''
  /api/content/articles/{slug}/:
    get:
      operationId: content_articles_retrieve
      description: GET /api/content/articles/ and /api/content/articles/{slug}/.
      parameters:
      - in: path
        name: slug
        schema:
          type: string
          title: Сегмент URL
        required: true
      tags:
      - content
      security:
      - cookieAuth: []
      - basicAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Article'
          description: ''
  /api/content/news/:
    get:
      operationId: content_news_list
      description: GET /api/content/news/ and /api/content/news/{slug}/.
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      tags:
      - content
      security:
      - cookieAuth: []
      - basicAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedNewsList'
          description: ''
  /api/content/news/{slug}/:
    get:
      operationId: content_news_retrieve
      description: GET /api/content/news/ and /api/content/news/{slug}/.
      parameters:
      - in: path
        name: slug
        schema:
          type: string
          title: Сегмент URL
        required: true
      tags:
      - content
      security:
      - cookieAuth: []
      - basicAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/News'
          description: ''
  /api/content/pages/:
    get:
      operationId: content_pages_list
      description: GET /api/content/pages/ and /api/content/pages/{slug}/.
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      tags:
      - content
      security:
      - cookieAuth: []
      - basicAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedPageList'
          description: ''
  /api/content/pages/{slug}/:
    get:
      operationId: content_pages_retrieve
      description: GET /api/content/pages/ and /api/content/pages/{slug}/.
      parameters:
      - in: path
        name: slug
        schema:
          type: string
          title: Сегмент URL
        required: true
      tags:
      - content
      security:
      - cookieAuth: []
      - basicAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Page'
          description: ''
  /api/csrf/:
    get:
      operationId: csrf_retrieve
      description: |-
        Return JSON {csrfToken} and set the csrftoken cookie.

        Args:
            request: DRF request.

        Returns:
            200 with {"csrfToken": "<token>"}.
      tags:
      - csrf
      security:
      - cookieAuth: []
      - basicAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/integrations/telegram/webhook/:
    post:
      operationId: integrations_telegram_webhook_create
      description: Accept a Telegram Update and optionally reply to a command.
      tags:
      - integrations
      security:
      - {}
      responses:
        '200':
          description: No response body
  /api/leads/:
    post:
      operationId: leads_create
      description: |-
        Handle POST: validate, honeypot check, create, schedule email.

        Args:
            request: DRF request with lead payload.

        Returns:
            201 with serialized lead (PII-safe: no email/phone in response),
            or 201 silent drop if honeypot is filled (no lead created),
            or 400 on validation errors.
      tags:
      - leads
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Lead'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Lead'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Lead'
        required: true
      security:
      - cookieAuth: []
      - basicAuth: []
      - {}
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Lead'
          description: ''
  /api/schema/:
    get:
      operationId: schema_retrieve
      description: |-
        OpenApi3 schema for this API. Format can be selected via content negotiation.

        - YAML: application/vnd.oai.openapi
        - JSON: application/vnd.oai.openapi+json
      parameters:
      - in: query
        name: format
        schema:
          type: string
          enum:
          - json
          - yaml
      - in: query
        name: lang
        schema:
          type: string
          enum:
          - af
          - ar
          - ar-dz
          - ast
          - az
          - be
          - bg
          - bn
          - br
          - bs
          - ca
          - ckb
          - cs
          - cy
          - da
          - de
          - dsb
          - el
          - en
          - en-au
          - en-gb
          - eo
          - es
          - es-ar
          - es-co
          - es-mx
          - es-ni
          - es-ve
          - et
          - eu
          - fa
          - fi
          - fr
          - fy
          - ga
          - gd
          - gl
          - he
          - hi
          - hr
          - hsb
          - ht
          - hu
          - hy
          - ia
          - id
          - ig
          - io
          - is
          - it
          - ja
          - ka
          - kab
          - kk
          - km
          - kn
          - ko
          - ky
          - lb
          - lt
          - lv
          - mk
          - ml
          - mn
          - mr
          - ms
          - my
          - nb
          - ne
          - nl
          - nn
          - os
          - pa
          - pl
          - pt
          - pt-br
          - ro
          - ru
          - sk
          - sl
          - sq
          - sr
          - sr-latn
          - sv
          - sw
          - ta
          - te
          - tg
          - th
          - tk
          - tr
          - tt
          - udm
          - ug
          - uk
          - ur
          - uz
          - vi
          - zh-hans
          - zh-hant
      tags:
      - schema
      security:
      - cookieAuth: []
      - basicAuth: []
      - {}
      responses:
        '200':
          content:
            application/vnd.oai.openapi:
              schema:
                type: object
                additionalProperties: {}
            application/yaml:
              schema:
                type: object
                additionalProperties: {}
            application/vnd.oai.openapi+json:
              schema:
                type: object
                additionalProperties: {}
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/search/:
    get:
      operationId: search_retrieve
      description: |-
        Handle GET: parse `q`, run FTS on all content models, paginate.

        Args:
            request: DRF request with optional `q` query parameter.

        Returns:
            200 with paginated results: {count, next, previous, results}.
            Each result: {type, slug, title, url, snippet}.
      tags:
      - search
      security:
      - cookieAuth: []
      - basicAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SearchResponse'
          description: ''
  /api/settings/public/:
    get:
      operationId: settings_public_retrieve
      description: |-
        Return Yandex Metrika / GA4 IDs from SiteSettings with env defaults.

        Args:
            request: unused DRF request.

        Returns:
            JSON with yandex_metrika_id and ga4_measurement_id (may be empty).
      tags:
      - settings
      responses:
        '200':
          description: No response body
components:
  schemas:
    Article:
      type: object
      description: 'Article detail: list fields + SKUs mentioned in the text.'
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          readOnly: true
          title: Заголовок
        slug:
          type: string
          readOnly: true
          title: Сегмент URL
          pattern: ^[-a-zA-Z0-9_]+$
        excerpt:
          type: string
          readOnly: true
          title: Анонс
          description: Краткий анонс для списка статей (без HTML).
        cover:
          type: string
          format: uri
          nullable: true
          readOnly: true
        cover_dark:
          type: string
          format: uri
          nullable: true
          readOnly: true
        body:
          type: string
          readOnly: true
          title: Текст
        is_published:
          type: boolean
          readOnly: true
          title: Опубликовано
          description: Видимость в публичном API.
        published_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
          title: Дата публикации
          description: Дата публикации (для сортировки/SEO); пусто = черновик.
        created_at:
          type: string
          format: date-time
          readOnly: true
          title: Создано
        updated_at:
          type: string
          format: date-time
          readOnly: true
          title: Обновлено
        related_skus:
          type: array
          items:
            type: object
            additionalProperties: {}
          description: Return catalog cards for models referenced in the article.
          readOnly: true
      required:
      - body
      - cover
      - cover_dark
      - created_at
      - excerpt
      - id
      - is_published
      - published_at
      - related_skus
      - slug
      - title
      - updated_at
    ArticleList:
      type: object
      description: Article card for /statyi list (no related SKUs).
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          readOnly: true
          title: Заголовок
        slug:
          type: string
          readOnly: true
          title: Сегмент URL
          pattern: ^[-a-zA-Z0-9_]+$
        excerpt:
          type: string
          readOnly: true
          title: Анонс
          description: Краткий анонс для списка статей (без HTML).
        cover:
          type: string
          format: uri
          nullable: true
          readOnly: true
        cover_dark:
          type: string
          format: uri
          nullable: true
          readOnly: true
        body:
          type: string
          readOnly: true
          title: Текст
        is_published:
          type: boolean
          readOnly: true
          title: Опубликовано
          description: Видимость в публичном API.
        published_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
          title: Дата публикации
          description: Дата публикации (для сортировки/SEO); пусто = черновик.
        created_at:
          type: string
          format: date-time
          readOnly: true
          title: Создано
        updated_at:
          type: string
          format: date-time
          readOnly: true
          title: Обновлено
      required:
      - body
      - cover
      - cover_dark
      - created_at
      - excerpt
      - id
      - is_published
      - published_at
      - slug
      - title
      - updated_at
    Category:
      type: object
      description: Public category list/detail fields (series overview + install).
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          readOnly: true
          title: Название
        slug:
          type: string
          readOnly: true
          title: Сегмент URL
          pattern: ^[-a-zA-Z0-9_]+$
        parent:
          type: integer
          readOnly: true
          nullable: true
          title: Родитель
          description: Родительская категория (пусто = корень дерева).
        description:
          type: string
          readOnly: true
          title: Описание
          description: Общее описание линейки продукции (для страницы категории).
        instructions:
          type: string
          readOnly: true
          title: Инструкция
          description: Общая инструкция по монтажу/управлению для линейки продукции.
        image:
          type: object
          additionalProperties: {}
          nullable: true
          description: First published product photo in this category (homepage tiles).
          readOnly: true
      required:
      - description
      - id
      - image
      - instructions
      - name
      - parent
      - slug
    FileTypeEnum:
      enum:
      - datasheet
      - certificate
      - catalog
      - other
      type: string
      description: |-
        * `datasheet` - Паспорт
        * `certificate` - Сертификат
        * `catalog` - Каталог
        * `other` - Прочее
    Lead:
      type: object
      description: |-
        Serializer for public Lead creation (RFQ / consultation / replacement).

        Only client-facing fields are writable; status/timestamps are read-only.
        `email` and `phone` are write-only (PII-safe response). `website` is a
        honeypot field — the view silently drops submissions where it's filled.
      properties:
        id:
          type: integer
          readOnly: true
        lead_type:
          allOf:
          - $ref: '#/components/schemas/LeadTypeEnum'
          title: Тип заявки
        name:
          type: string
          title: Имя
          maxLength: 200
        email:
          type: string
          format: email
          writeOnly: true
          title: Эл. почта
          maxLength: 254
        phone:
          type: string
          writeOnly: true
          title: Телефон
          maxLength: 50
        company:
          type: string
          title: Компания
          maxLength: 200
        message:
          type: string
          title: Сообщение
        sku:
          type: string
          title: Сегмент URL
          nullable: true
        quantity:
          type: integer
          maximum: 2147483647
          minimum: 0
          nullable: true
          title: Количество
          description: Количество позиций в запросе КП (RFQ).
        analog_belimo_code:
          type: string
          title: Код аналога Belimo
          description: Код аналога Belimo (для заявок на замену).
          maxLength: 100
        status:
          allOf:
          - $ref: '#/components/schemas/StatusEnum'
          readOnly: true
          title: Статус
        created_at:
          type: string
          format: date-time
          readOnly: true
          title: Создано
        updated_at:
          type: string
          format: date-time
          readOnly: true
          title: Обновлено
        website:
          type: string
          writeOnly: true
          default: ''
          description: Honeypot — leave empty (hidden from real users).
      required:
      - created_at
      - email
      - id
      - message
      - name
      - status
      - updated_at
    LeadTypeEnum:
      enum:
      - rfq
      - consultation
      - replacement
      type: string
      description: |-
        * `rfq` - Запрос КП
        * `consultation` - Консультация
        * `replacement` - Подбор замены
    News:
      type: object
      description: Company news item (/novosti/<slug>).
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          readOnly: true
          title: Заголовок
        slug:
          type: string
          readOnly: true
          title: Сегмент URL
          pattern: ^[-a-zA-Z0-9_]+$
        body:
          type: string
          readOnly: true
          title: Текст
        cover:
          type: string
          format: uri
          nullable: true
          readOnly: true
        is_published:
          type: boolean
          readOnly: true
          title: Опубликовано
          description: Видимость в публичном API.
        published_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
          title: Дата публикации
          description: Дата публикации (для сортировки/SEO); пусто = черновик.
        created_at:
          type: string
          format: date-time
          readOnly: true
          title: Создано
        updated_at:
          type: string
          format: date-time
          readOnly: true
          title: Обновлено
      required:
      - body
      - cover
      - created_at
      - id
      - is_published
      - published_at
      - slug
      - title
      - updated_at
    Page:
      type: object
      description: Public CMS page (/<slug>).
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          readOnly: true
          title: Заголовок
        slug:
          type: string
          readOnly: true
          title: Сегмент URL
          pattern: ^[-a-zA-Z0-9_]+$
        body:
          type: string
          readOnly: true
          title: Текст
        is_published:
          type: boolean
          readOnly: true
          title: Опубликовано
          description: Видимость в публичном API.
        published_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
          title: Дата публикации
          description: Дата публикации (для сортировки/SEO); пусто = черновик.
        created_at:
          type: string
          format: date-time
          readOnly: true
          title: Создано
        updated_at:
          type: string
          format: date-time
          readOnly: true
          title: Обновлено
      required:
      - body
      - created_at
      - id
      - is_published
      - published_at
      - slug
      - title
      - updated_at
