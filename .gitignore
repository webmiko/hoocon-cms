# Hoocon CMS .gitignore
# Опора: каноничный шаблон БЗ/LMS, адаптированный под проект.
# _docs/ локально (gitignore через _*); docs/ — legacy, не в git.

# Виртуальное окружение
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/

# Логи
*.log
logs/*
!logs/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Cursor + вход агента / план — только локально
.cursor/
AGENTS.md
ПЛАН-ПРОЕКТА.md

# Локальные "_" пути (симлинки или каталоги): БЗ, PDF-инструкции и пр.
# Без завершающего «/» — иначе symlink не матчится как directory.
_*
# Не глотать Python-пакеты: иначе accounts/migrations/__init__.py не в git →
# Django считает app unmigrated и CI падает на FK к auth_user.
!**/__init__.py
!**/__init__.pyi
_инструкции-pdf
_Универсальная-база-знаний

# Локальные override Compose (не коммитить)
docker-compose.override.yml
docker-compose.dev.yml
docker-compose.local.yml

# Переменные окружения
.env
.env.local
.env.*.local
!.env.example

# Локальные дампы / артефакты деплоя (не коммитить)
.deploy-tmp/
.local/

# Загрузки (media) и collectstatic
media/
backend/media/
backend/staticfiles/

# Frontend build artifacts
frontend/dist/
frontend/dev-dist/
node_modules/

# Demo slide raster exports (PNG/PDF) — локально в _docs/demo/export/
_docs/demo/export/

# Legacy docs/ (канон локально: _docs/, см. README)
docs/

# RU manual HTML / constructor — local only (also matched by ``_*`` above).
# Not for prod site; not tracked on develop after untrack.
_manuals-ru/

# Coverage / tooling artifacts
backend/coverage.json
coverage.json

# Базы данных
*.db
*.sqlite
*.sqlite3
*.db3

# Отчёты и тесты
reports/
temp_reports/
.coverage
.coverage.*
.pytest_cache/
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.dmypy.json

# Временные файлы
*.tmp

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# Celery
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Git (отдельный репозиторий)
.git_local/

# Шаблоны коммитов (не коммитить)
.git_commit_template
