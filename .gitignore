# Hoocon CMS .gitignore
# Опора: каноничный шаблон БЗ/LMS, адаптированный под проект.
# Проект docs-first: .md файлы трекаются (docs/, AGENTS.md, ПЛАН-ПРОЕКТА.md).

# Виртуальное окружение
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/

# Логи
*.log
logs/*
!logs/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Cursor: правила трекаем, остальное в .cursor/ игнорируем
.cursor/*
!.cursor/rules/

# Каталоги с префиксом "_" — игнор, кроме KB-симлинка (канон БЗ)
_*/
!_Универсальная-база-знаний

# Локальные override Compose (не коммитить)
docker-compose.override.yml
docker-compose.dev.yml
docker-compose.local.yml

# Переменные окружения
.env
.env.local
.env.*.local
!.env.example

# Загрузки (media) и collectstatic
media/
backend/media/
backend/staticfiles/

# Frontend build artifacts
frontend/dist/
frontend/dev-dist/
node_modules/

# Coverage / tooling artifacts
backend/coverage.json
coverage.json

# Базы данных
*.db
*.sqlite
*.sqlite3
*.db3

# Отчёты и тесты
reports/
temp_reports/
.coverage
.coverage.*
.pytest_cache/
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.dmypy.json

# Временные файлы
*.tmp

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# Celery
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Git (отдельный репозиторий)
.git_local/

# Шаблоны коммитов (не коммитить)
.git_commit_template
